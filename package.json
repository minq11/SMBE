{
  "name": "smbe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-constitution.mjs && next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-constitution.mjs",
    "check:constitution": "node scripts/check-constitution.mjs",
    "check:connections": "tsx scripts/check-connections.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reconcile-headcounts": "tsx scripts/reconcile-headcounts.ts",
    "test:e2e": "playwright test",
    "test:db": "node --conditions=react-server --import tsx --test tests/database.test.ts",
    "test:attachments": "node --conditions=react-server --import tsx --test tests/attachments.test.ts",
    "test:board": "node --conditions=react-server --import tsx --test tests/board.test.ts",
    "test:assessments": "node --conditions=react-server --import tsx --test tests/assessments.test.ts",
    "test:orders-ui": "node scripts/test-work-orders-ui.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@neondatabase/serverless": "^1.0.2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "browser-image-compression": "^2.0.2",
    "lucide-react": "^0.468.0",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "pretendard": "^1.3.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "pg": "^8.23.0",
    "prettier": "^3.9.8",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
