# Local Docker: .env.local / Lightsail: .env
# Do not put real credentials in this template.
DATABASE_URL=
AWS_REGION=ap-northeast-2
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# 32+ random characters, readiness API only.
HEALTHCHECK_TOKEN=
# Production: :80 for IP preview, domain.example.com for HTTPS.
SITE_ADDRESS=:80
LOCAL_PORT=3001

# Auth.js — 32+ random characters (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
AUTH_SECRET=
# Behind a proxy in production (Caddy). Leave unset in dev.
AUTH_TRUST_HOST=
# OAuth providers — register each provider console, fill client id/secret.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=

# Email (Resend) — 초대 이메일 발송용. 값이 비어 있으면 발송 스킵하고 링크만 생성.
RESEND_API_KEY=
# 예: onboarding@resend.dev (도메인 검증 전) 또는 no-reply@yourdomain.com (검증 후)
EMAIL_FROM=
# 초대 링크 · 이메일 본문에 사용될 사이트 URL. 미설정 시 요청 헤더에서 유추.
APP_URL=
