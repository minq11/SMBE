# Local Docker: .env.local / Lightsail: .env
# Do not put real credentials in this template.
DATABASE_URL=
# S3 첨부 사진 저장. IAM 사용자 발급 (PutObject/GetObject/DeleteObject 만 허용).
# AWS_SESSION_TOKEN 은 SSO/STS 임시 크리덴셜 쓸 때만 필요, IAM 장기 키면 비워둠.
AWS_REGION=ap-northeast-2
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# 32+ random characters, readiness API only.
HEALTHCHECK_TOKEN=
# 32+ random characters. 배치 엔드포인트(/api/cron/*) 인증. 호스트 cron 이 사용.
# 미설정 시 배치 엔드포인트는 항상 401 이며, 미실시 회의 알림이 나가지 않습니다.
CRON_SECRET=
# Production: :80 for IP preview, domain.example.com for HTTPS.
SITE_ADDRESS=:80
LOCAL_PORT=3001

# Auth.js — 32+ random characters (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
AUTH_SECRET=
# Behind a proxy in production (Caddy). Leave unset in dev.
AUTH_TRUST_HOST=
# OAuth providers — register each provider console, fill client id/secret.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=

# Email (Resend) — 초대 이메일 발송용. 값이 비어 있으면 발송 스킵하고 링크만 생성.
RESEND_API_KEY=
# 프로덕션 예: SMBE <no-reply@smbe.net>
# 도메인 미검증 임시값: onboarding@resend.dev (수신자를 Resend 계정 이메일로 한정)
EMAIL_FROM=
# 초대 링크 · 이메일 본문에 사용될 사이트 URL. 미설정 시 요청 헤더에서 유추.
# 로컬:      http://127.0.0.1:3001
# 프로덕션:  https://smbe.net
APP_URL=

# SMBE 운영자 백오피스 접근 허용 이메일 (콤마 구분). 이 계정으로 로그인한 사용자만 /admin 접근 가능.
# 예: gooddonutsyh@gmail.com,partner@example.com
SMBE_OPERATOR_EMAILS=

# /contact 폼 제출이 도착할 주소. 미설정 시 hi@smbe.net 사용.
CONTACT_INBOX=
